# Copia este archivo a .env y complétalo. Nunca subas .env al repositorio.

# Token de Plex (ver README: "Cómo obtener el PLEX_TOKEN")
PLEX_TOKEN=

# Acceso a la interfaz web. Si APP_PASSWORD queda vacío, la interfaz queda SIN contraseña.
APP_USER=admin
APP_PASSWORD=

# Puerto de la interfaz dentro del contenedor (por defecto 8000).
# Con network_mode: host es el puerto del servidor; cámbialo si 8000 está ocupado.
# APP_PORT=8000
